<Window x:Class="V60Control.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preset" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Text="Name für das Preset:" Margin="0,0,0,8"/>
        <TextBox x:Name="NameBox" FontSize="14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Abbrechen" MinWidth="90" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="OK" MinWidth="90" Style="{StaticResource AccentButton}"
                    IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
