<Window x:Class="V60Control.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="V60 Camera Control" Width="1380" Height="860"
        MinWidth="1050" MinHeight="640"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= LINKS: VIDEO + PRESETS ======================= -->
        <Grid Grid.Column="0" Margin="10,10,5,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Videofenster -->
            <Border Grid.Row="0" Background="Black" CornerRadius="8" ClipToBounds="True">
                <vlc:VideoView x:Name="VideoView" Background="Black">
                    <!-- Overlay-Ebene der VideoView: deckt ohne laufendes Video das
                         native (weiß zeichnende) VLC-Fenster komplett schwarz ab -->
                    <Grid x:Name="VideoOverlay" Background="Black">
                        <TextBlock x:Name="NoSignalText" Text="Nicht verbunden"
                                   Foreground="{StaticResource FgDim}" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </vlc:VideoView>
            </Border>

            <!-- Presets -->
            <TextBlock Grid.Row="1" Style="{StaticResource SectionHeader}" Text="PRESETS"/>
            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="8"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200"
                              HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel>
                        <!-- Neues Preset -->
                        <Button x:Name="AddPresetButton" Width="150" Height="118" Margin="4"
                                Click="AddPreset_Click" ToolTip="Aktuelle Kameraposition als Preset speichern (mit Snapshot als Vorschaubild)">
                            <StackPanel>
                                <TextBlock Text="＋" FontSize="30" HorizontalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Neues Preset" HorizontalAlignment="Center"
                                           Foreground="{StaticResource FgDim}"/>
                            </StackPanel>
                        </Button>

                        <!-- Preset-Kacheln -->
                        <ItemsControl x:Name="PresetList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="150" Height="118" Margin="4" Padding="0"
                                            Click="Preset_Click" Tag="{Binding}"
                                            ToolTip="Klicken zum Anfahren – Rechtsklick für Optionen">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Anfahren" Click="PresetRecallMenu_Click" Tag="{Binding}"/>
                                                <MenuItem Header="Position &amp; Bild aktualisieren" Click="PresetUpdate_Click" Tag="{Binding}"/>
                                                <MenuItem Header="Umbenennen" Click="PresetRename_Click" Tag="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="Löschen" Click="PresetDelete_Click" Tag="{Binding}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#FF15171A" CornerRadius="5,5,0,0" ClipToBounds="True">
                                                <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/>
                                            </Border>
                                            <Border Grid.Row="1" Background="#FF2A2E34" CornerRadius="0,0,5,5" Padding="6,3">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                           FontSize="12" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ======================= RECHTS: STEUERUNG ======================= -->
        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8"
                Margin="5,10,10,10" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,10,14,14">

                    <!-- Verbindung -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="VERBINDUNG"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="IpBox" Grid.Column="0" Text="192.168.100.88"
                                 ToolTip="IP-Adresse der Kamera" FontSize="14"/>
                        <Button x:Name="ConnectButton" Grid.Column="1" Content="Verbinden"
                                Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                                Click="Connect_Click" MinWidth="92"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource DangerBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Getrennt" Margin="7,0,0,0"
                                   Foreground="{StaticResource FgDim}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- PTZ -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="SCHWENKEN / NEIGEN"/>
                    <Grid HorizontalAlignment="Center" Width="170">
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PadUL"   Grid.Row="0" Grid.Column="0" Style="{StaticResource PadButton}" Content="↖"/>
                        <Button x:Name="PadUp"   Grid.Row="0" Grid.Column="1" Style="{StaticResource PadButton}" Content="↑"/>
                        <Button x:Name="PadUR"   Grid.Row="0" Grid.Column="2" Style="{StaticResource PadButton}" Content="↗"/>
                        <Button x:Name="PadLeft" Grid.Row="1" Grid.Column="0" Style="{StaticResource PadButton}" Content="←"/>
                        <Button x:Name="PadHome" Grid.Row="1" Grid.Column="1" Style="{StaticResource PadButton}" Content="⌂"
                                ToolTip="Kamera in Mittelstellung fahren" Click="Home_Click"/>
                        <Button x:Name="PadRight" Grid.Row="1" Grid.Column="2" Style="{StaticResource PadButton}" Content="→"/>
                        <Button x:Name="PadDL"   Grid.Row="2" Grid.Column="0" Style="{StaticResource PadButton}" Content="↙"/>
                        <Button x:Name="PadDown" Grid.Row="2" Grid.Column="1" Style="{StaticResource PadButton}" Content="↓"/>
                        <Button x:Name="PadDR"   Grid.Row="2" Grid.Column="2" Style="{StaticResource PadButton}" Content="↘"/>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Geschwindigkeit" Foreground="{StaticResource FgDim}"
                                   VerticalAlignment="Center" FontSize="12"/>
                        <Slider x:Name="PtSpeedSlider" Grid.Column="1" Minimum="1" Maximum="24" Value="12"
                                Margin="8,0" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock Grid.Column="2" Text="{Binding ElementName=PtSpeedSlider, Path=Value, StringFormat=N0}"
                                   VerticalAlignment="Center" MinWidth="20" TextAlignment="Right"/>
                    </Grid>

                    <!-- Zoom -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="ZOOM"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ZoomOutButton" Grid.Column="0" Content="−  Raus" Margin="0,0,4,0" MinHeight="40"/>
                        <Button x:Name="ZoomInButton" Grid.Column="1" Content="＋  Rein" Margin="4,0,0,0" MinHeight="40"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Geschwindigkeit" Foreground="{StaticResource FgDim}"
                                   VerticalAlignment="Center" FontSize="12"/>
                        <Slider x:Name="ZoomSpeedSlider" Grid.Column="1" Minimum="0" Maximum="7" Value="5"
                                Margin="8,0" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock Grid.Column="2" Text="{Binding ElementName=ZoomSpeedSlider, Path=Value, StringFormat=N0}"
                                   VerticalAlignment="Center" MinWidth="20" TextAlignment="Right"/>
                    </Grid>

                    <!-- Fokus -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="FOKUS"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="FocusNearButton" Grid.Column="0" Content="Nah" Margin="0,0,3,0"/>
                        <Button x:Name="FocusFarButton" Grid.Column="1" Content="Fern" Margin="3,0"/>
                        <Button x:Name="FocusAutoButton" Grid.Column="2" Content="Auto" Margin="3,0,0,0"
                                Click="FocusAuto_Click" ToolTip="Autofokus aktivieren"/>
                    </Grid>

                    <!-- Video-Einstellungen -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="VIDEO / LATENZ"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Puffer (ms)" Foreground="{StaticResource FgDim}"
                                   VerticalAlignment="Center" FontSize="12"
                                   ToolTip="Netzwerkpuffer: kleiner = weniger Verzögerung, größer = stabileres Bild"/>
                        <Slider x:Name="LatencySlider" Grid.Column="1" Minimum="0" Maximum="500" Value="100"
                                Margin="8,0" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="10"/>
                        <TextBlock Grid.Column="2" Text="{Binding ElementName=LatencySlider, Path=Value, StringFormat=N0}"
                                   VerticalAlignment="Center" MinWidth="28" TextAlignment="Right"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <RadioButton x:Name="MainStreamRadio" Content="Main-Stream" IsChecked="True"
                                     Foreground="{StaticResource FgBrush}" Margin="0,0,12,0"
                                     ToolTip="1080p – beste Qualität"/>
                        <RadioButton x:Name="SubStreamRadio" Content="Sub-Stream"
                                     Foreground="{StaticResource FgBrush}"
                                     ToolTip="Niedrigere Auflösung – weniger Bandbreite/Latenz"/>
                    </StackPanel>
                    <CheckBox x:Name="RtspTcpCheck" Content="RTSP über TCP (stabiler)" IsChecked="True" Margin="0,6,0,0"/>
                    <CheckBox x:Name="MuteCheck" Content="Ton stumm" IsChecked="True" Margin="0,6,0,0"
                              Checked="Mute_Changed" Unchecked="Mute_Changed"/>
                    <Button x:Name="ApplyVideoButton" Content="Video neu starten" Margin="0,10,0,0"
                            Click="ApplyVideo_Click"
                            ToolTip="Übernimmt Puffer-/Stream-Einstellungen und verbindet das Video neu"/>

                    <!-- Hinweis -->
                    <TextBlock Margin="0,14,0,0" FontSize="11" Foreground="{StaticResource FgDim}" TextWrapping="Wrap"
                               Text="Tastatur: Pfeiltasten = Schwenken/Neigen, Bild↑/Bild↓ = Zoom, Pos1 = Home"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
